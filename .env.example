# Application
DATACURRENT_ENV=development
DATACURRENT_LOG_LEVEL=INFO
DATACURRENT_SECRET_KEY=replace-with-at-least-32-random-characters
DATACURRENT_ENCRYPTION_KEY=replace-with-a-fernet-key
DATACURRENT_PUBLIC_URL=http://localhost:3000

# DataCurrent metadata database and cache
DATABASE_URL=postgresql+psycopg://datacurrent:datacurrent@postgres:5432/datacurrent
REDIS_URL=redis://redis:6379/0

# Demo sources
DEMO_POSTGRES_URL=postgresql://demo_reader:demo_reader@demo-postgres:5432/commerce
DEMO_SNOWFLAKE_ACCOUNT=
DEMO_SNOWFLAKE_USER=
DEMO_SNOWFLAKE_PASSWORD=
DEMO_SNOWFLAKE_WAREHOUSE=
DEMO_SNOWFLAKE_DATABASE=
DEMO_SNOWFLAKE_SCHEMA=PUBLIC

# AI features are optional; the product remains useful without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Browser-facing API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
